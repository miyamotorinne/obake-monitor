# Required. Do not use the old default value or commit the real password.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Recommended. Use a separate long random value to sign admin sessions.
ADMIN_SESSION_SECRET=replace-with-another-long-random-secret

# Production database. If omitted, the app uses the local obake.db file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
